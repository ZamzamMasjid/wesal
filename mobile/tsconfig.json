{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "App.tsx",
    "App.test.tsx",
    "jest.setup.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
