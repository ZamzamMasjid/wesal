# Copy to .env.local for development. Production secrets live in Fly secrets.
DATABASE_URL=postgres://wesal:wesal@localhost:5432/wesal
TEST_DATABASE_URL=postgres://wesal:wesal@localhost:5432/wesal_test

# Staff login (Better Auth). Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
# Dev owner password used by `npm run db:seed` (login: owner)
# SEED_OWNER_PASSWORD=owner-password

# Messaging (message-delivery). Without MESSAGING_PROVIDER=twilio messages are only
# logged, so development and tests never reach Twilio. Never commit real values.
# MESSAGING_PROVIDER=twilio   # or whatsend (fee-free, WhatsApp only; see ADR-031)
# WHATSEND_WORKER_URL=http://127.0.0.1:3001
# WHATSEND_WORKER_SECRET=
# WHATSEND_SESSION_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_SMS_FROM=
# Public origin Twilio posts status callbacks to (defaults to BETTER_AUTH_URL).
# PUBLIC_BASE_URL=
# JOBS=off   # do not start the in-process job loop
